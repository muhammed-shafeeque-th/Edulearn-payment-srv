  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "postbuild:avro": "xcopy /E /I /Y src\\infrastructure\\kafka\\avro-schemas dist\\infrastructure\\kafka\\avro-schemas",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start",
    "start:dev:watch": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "proto:gen": "npx protoc --plugin=protoc-gen-ts_proto=\"D:\\Edulearn\\api-gateway\\node_modules\\.bin\\protoc-gen-ts_proto.cmd\" --ts_proto_out=./src/infrastructure/grpc/generated --ts_proto_opt=outputServices=grpc-js,esModuleInterop=true,nestJs=true -I ./node_modules/@edulearn/core/protos/payment ./node_modules/@edulearn/core/protos/payment/*.proto"
  },
